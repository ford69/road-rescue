{
  "name": "road-rescue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "admin:create": "npm --prefix backend run admin:create --",
    "build": "vite build",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "check": "npm run typecheck && npm run lint && npm run build",
    "check:all": "npm run check && npm --prefix backend run check",
