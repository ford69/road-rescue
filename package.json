    "postcss": "^8.4.35",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
