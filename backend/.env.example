NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/road-rescue-ghana
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated list for production, e.g.:
# CLIENT_ORIGIN=https://roadrescue4u.com,http://localhost:5173
COOKIE_SECURE=false
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
SEED_ADMIN_EMAIL=admin@roadrescue.gh
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_PHONE=+233241000001
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/customer/history
