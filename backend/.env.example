NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/road-rescue-ghana
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Verification and password-reset emails use CLIENT_ORIGIN (first origin) as the frontend base URL.
# Production (required for browser signup/login from the live site):
# NODE_ENV=production
# COOKIE_SECURE=true
# CLIENT_ORIGIN=https://roadrescue4u.com
# Include www if you serve that host too:
# CLIENT_ORIGIN=https://roadrescue4u.com,https://www.roadrescue4u.com
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/road_rescue
COOKIE_SECURE=false
UPLOAD_DIR=uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
SEED_ADMIN_EMAIL=admin@roadrescue.gh
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_PHONE=+233241000001
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASIC_PLAN_CODE=
# Browser return after Paystack Checkout — frontend page, not an API route.
PAYSTACK_CALLBACK_URL=http://localhost:5173/auth/complete-subscription
PLATFORM_FEE_PERCENT=15
SUBSCRIPTION_BASIC_PRICE_GHS=49
SUBSCRIPTION_PREMIUM_PRICE_GHS=99

# Brevo transactional email (https://app.brevo.com)
# Create an API key under SMTP & API → API Keys
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=noreply@roadrescue4u.com
BREVO_SENDER_NAME=Road Rescue Ghana
BREVO_REPLY_TO_EMAIL=
# Inbox that receives Help & Support form submissions
SUPPORT_EMAIL=support@roadrescue4u.com
# Optional: Brevo dashboard template IDs (leave blank to use built-in HTML)
# Template params expected by backend:
#   verify_email: FIRSTNAME, VERIFY_URL
#   reset_password: FIRSTNAME, RESET_URL
#   welcome: FIRSTNAME, HOME_URL, ROLE
#   mechanic_pending: FIRSTNAME, GARAGE_NAME
BREVO_TEMPLATE_VERIFY_EMAIL=
BREVO_TEMPLATE_RESET_PASSWORD=
BREVO_TEMPLATE_WELCOME=
BREVO_TEMPLATE_MECHANIC_PENDING=
